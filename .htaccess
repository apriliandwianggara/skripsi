<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Blokir akses langsung ke file tersembunyi (.env, .git, dll) dan file sensitif
    RewriteRule ^\.(?!well-known).* - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package(-lock)?\.json - [F,L,NC]
    RewriteRule ^(storage|bootstrap/cache|vendor|database)/.* - [F,L,NC]
    RewriteRule ^.*\.log$ - [F,L,NC]

    # 2. Teruskan semua request ke folder public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
